{
    "name": "qrowg",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "cd apps/web && node scripts/check-jsx-imports.mjs && npx next build && node scripts/budget-page-publique.mjs",
        "budget:page-publique": "cd apps/web && node scripts/budget-page-publique.mjs",
        "check:imports": "cd apps/web && node scripts/check-jsx-imports.mjs",
        "type-check": "cd apps/web && npx tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:filet": "playwright test e2e/choixAuRetour.spec.ts e2e/historiqueDestination.spec.ts e2e/menuQuiSeDeplie.spec.ts e2e/nomDuCommerce.spec.ts e2e/unSeulMenu.spec.ts e2e/galerieDashboardForfaits.spec.ts e2e/prixAnnuelCoherent.spec.ts e2e/exportQrSansRupture.spec.ts e2e/gererUnQrCompact.spec.ts e2e/atelierQrQuiAboutit.spec.ts e2e/qrImprimeCommeDessine.spec.ts e2e/curseurAvantApres.spec.ts e2e/formulairesEnLigne.spec.ts e2e/sauvegardeDeLEditeur.spec.ts --project=desktop",
        "test:e2e:report": "playwright show-report",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
        "db:push": "supabase db push",
        "db:reset": "supabase db reset",
        "db:types": "supabase gen types typescript --linked --schema public > apps/web/src/lib/supabase/database.generated.ts"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.0.0",
        "@commitlint/config-conventional": "^19.0.0",
        "@playwright/test": "^1.62.1",
        "@types/node": "25.9.1",
        "@types/react": "18.3.31",
        "@types/react-dom": "18.3.7",
        "husky": "^9.0.0",
        "lint-staged": "^15.0.0",
        "prettier": "^3.2.0",
        "prettier-plugin-tailwindcss": "^0.6.0",
        "turbo": "^2.0.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.11"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "engines": {
        "node": "24.x",
        "pnpm": ">=9.0.0"
    },
    "packageManager": "pnpm@9.1.0",
    "pnpm": {
        "overrides": {
            "postcss": "^8.5.23",
            "sharp": "^0.35.4",
            "d3-color": "^3.1.0",
            "dompurify": "^3.4.13",
            "nanoid@3": "^3.3.18",
            "js-yaml@4": "^4.3.2",
            "fast-uri": "^3.1.6",
            "baseline-browser-mapping": "^2.11.0"
        }
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.111.0",
        "@supabase/ssr": "^0.10.3",
        "@supabase/supabase-js": "^2.106.1",
        "@vercel/analytics": "^2.0.1",
        "jspdf": "^4.2.1",
        "jsqr": "^1.4.0",
        "lucide-react": "^1.17.0",
        "next": "~16.3.3",
        "qr-code-styling": "^1.9.2",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-simple-maps": "^3.0.0",
        "recharts": "^3.8.1",
        "resend": "^6.12.4",
        "stripe": "^22.2.0",
        "svg2pdf.js": "2.9.0"
    }
}
