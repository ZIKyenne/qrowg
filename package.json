{
    "name": "qrowg",
    "version": "0.0.1",
    "private": true,
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "turbo run dev",
        "build": "cd apps/web && node scripts/check-jsx-imports.mjs && npx next build",
        "check:imports": "cd apps/web && node scripts/check-jsx-imports.mjs",
        "type-check": "cd apps/web && npx tsc --noEmit -p tsconfig.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:e2e": "playwright test",
        "test:e2e:headed": "playwright test --headed",
        "test:e2e:ui": "playwright test --ui",
        "test:e2e:report": "playwright show-report",
        "lint": "turbo run lint",
        "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
        "db:push": "supabase db push",
        "db:reset": "supabase db reset",
        "db:types": "supabase gen types typescript --local > packages/database/types/supabase.ts"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.0.0",
        "@commitlint/config-conventional": "^19.0.0",
        "@playwright/test": "^1.62.1",
        "@types/node": "25.9.1",
        "@types/react": "19.2.15",
        "@types/react-dom": "19.2.3",
        "husky": "^9.0.0",
        "lint-staged": "^15.0.0",
        "prettier": "^3.2.0",
        "prettier-plugin-tailwindcss": "^0.6.0",
        "turbo": "^2.0.0",
        "typescript": "^5.9.3",
        "vitest": "^4.1.9"
    },
    "lint-staged": {
        "*.{ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "engines": {
        "node": ">=20.0.0",
        "pnpm": ">=9.0.0"
    },
    "packageManager": "pnpm@9.1.0",
    "pnpm": {
        "overrides": {
            "postcss": "^8.5.23",
            "sharp": "^0.35.0",
            "d3-color": "^3.1.0",
            "dompurify": "^3.4.13",
            "nanoid@3": "^3.3.18",
            "baseline-browser-mapping@<=2.11.0": "2.11.0",
            "immer@<=11.1.9": "11.1.9"
        }
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.111.0",
        "@supabase/ssr": "^0.10.3",
        "@supabase/supabase-js": "^2.106.1",
        "@vercel/analytics": "^2.0.1",
        "jspdf": "^4.2.1",
        "jsqr": "^1.4.0",
        "jszip": "^3.10.1",
        "lucide-react": "^1.17.0",
        "nanoid": "^5.1.16",
        "next": "~16.2.11",
        "qr-code-styling": "^1.9.2",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-simple-maps": "^3.0.0",
        "recharts": "^3.9.1",
        "resend": "^6.12.4",
        "stripe": "^22.2.0"
    }
}
